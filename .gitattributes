*.rb         text eol=lf
*.rtt        text eol=lf
*.rttpkg     text eol=lf
*.sh         text eol=lf
*.sln        text eol=lf
*.svg        text eol=lf
*.toml       text eol=lf
*.txt        text eol=lf
*.utestcases text eol=lf
*.uvopt      text eol=lf
*.uvoptx     text eol=lf
*.uvproj     text eol=lf
*.uvprojx    text eol=lf
*.vcproj     text eol=lf
*.vcxproj    text eol=lf
*.workspace  text eol=lf
*.xml        text eol=lf
*.xsd        text eol=lf
