# Binary assets and toolchain outputs: do not normalize, diff, or merge.
*.a       binary
*.bin     binary
*.bmp     binary
*.elf     binary
*.exe     binary
*.gif     binary
*.gz      binary
*.h264    binary
*.ico     binary
*.jpeg    binary
*.jpg     binary
*.lib     binary
*.lzo     binary
*.LZO     binary
*.mp4     binary
*.opt     binary
*.Opt     binary
*.pdf     binary
*.png     binary
*.pyc     binary
*.tar     binary
*.tgz     binary
*.uv2     binary
*.Uv2     binary
*.yuyv    binary
*.YUYV    binary
*.zip     binary

# GitHub Linguist: uppercase extensions in this codebase are still C headers/sources.
*.C linguist-language=C
*.H linguist-language=C
