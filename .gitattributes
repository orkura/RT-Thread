# Normalize text files in the repository and working tree to LF.
* text=auto eol=lf

# Source code, linker scripts, and build scripts.
*.S          text eol=lf
*.asm        text eol=lf
*.c          text eol=lf
*.C          text eol=lf
*.cc         text eol=lf
*.cpp        text eol=lf
*.cxx        text eol=lf
*.h          text eol=lf
*.H          text eol=lf
*.hpp        text eol=lf
*.icf        text eol=lf
*.inc        text eol=lf
*.ld         text eol=lf
*.mak        text eol=lf
*.mk         text eol=lf
*.s          text eol=lf
*.sct        text eol=lf
*.x          text eol=lf
CMakeLists.txt text eol=lf
Jamfile        text eol=lf
Kconfig        text eol=lf
Kconfig.*      text eol=lf
Makefile       text eol=lf
SConscript     text eol=lf
SConstruct     text eol=lf

# Scripts, configuration, project files, and documentation.
