*.cfg        text eol=lf
*.cmake      text eol=lf
*.cmd        text eol=lf
*.Doxyfile   text eol=lf
*.ewp        text eol=lf
*.eww        text eol=lf
*.html       text eol=lf
*.in         text eol=lf
*.inf        text eol=lf
*.ini        text eol=lf
*.json       text eol=lf
*.lua        text eol=lf
*.m4         text eol=lf
*.md         text eol=lf
*.project    text eol=lf
