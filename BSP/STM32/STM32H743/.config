# CANopenNode CO_CONFIG groups
#

#
# Common flags
#
# CONFIG_PKG_CANOPENNODE_GLOBAL_CALLBACK_PRE is not set
# CONFIG_PKG_CANOPENNODE_GLOBAL_RT_CALLBACK_PRE is not set
# CONFIG_PKG_CANOPENNODE_GLOBAL_TIMERNEXT is not set
CONFIG_PKG_CANOPENNODE_GLOBAL_OD_DYNAMIC=y
# CONFIG_PKG_CANOPENNODE_USING_MULTIPLE_OD is not set
# end of Common flags

#
# CiA 301 NMT and heartbeat
#
# CONFIG_PKG_CANOPENNODE_NMT_CALLBACK_CHANGE is not set
CONFIG_PKG_CANOPENNODE_NMT_MASTER=y
CONFIG_PKG_CANOPENNODE_USING_HB_CONS=y
CONFIG_PKG_CANOPENNODE_HB_CONS_CALLBACK_NONE=y
# CONFIG_PKG_CANOPENNODE_HB_CONS_CALLBACK_CHANGE is not set
# CONFIG_PKG_CANOPENNODE_HB_CONS_CALLBACK_MULTI is not set
# CONFIG_PKG_CANOPENNODE_HB_CONS_QUERY_FUNCT is not set
# end of CiA 301 NMT and heartbeat

#
# CiA 301 legacy node guarding
#

#
# Node guarding is legacy and is not covered by demo CI profiles; prefer heartbeat supervision.
#
# CONFIG_PKG_CANOPENNODE_USING_NODE_GUARDING is not set
# end of CiA 301 legacy node guarding

#
# CiA 301 emergency object
#
CONFIG_PKG_CANOPENNODE_EM_PRODUCER=y
# CONFIG_PKG_CANOPENNODE_EM_PROD_CONFIGURABLE is not set
# CONFIG_PKG_CANOPENNODE_EM_PROD_INHIBIT is not set
CONFIG_PKG_CANOPENNODE_EM_HISTORY=y
# CONFIG_PKG_CANOPENNODE_EM_STATUS_BITS is not set
# CONFIG_PKG_CANOPENNODE_EM_CONSUMER is not set
CONFIG_PKG_CANOPENNODE_EM_ERR_STATUS_BITS_COUNT=80
CONFIG_PKG_CANOPENNODE_ERR_CONDITION_GENERIC_STACK=y
CONFIG_PKG_CANOPENNODE_ERR_CONDITION_COMMUNICATION_STACK=y
CONFIG_PKG_CANOPENNODE_ERR_CONDITION_MANUFACTURER_STACK=y
# CONFIG_PKG_CANOPENNODE_ERR_CONDITION_CURRENT_ZERO is not set
# CONFIG_PKG_CANOPENNODE_ERR_CONDITION_VOLTAGE_ZERO is not set
# CONFIG_PKG_CANOPENNODE_ERR_CONDITION_TEMPERATURE_ZERO is not set
# CONFIG_PKG_CANOPENNODE_ERR_CONDITION_DEV_PROFILE_ZERO is not set
# end of CiA 301 emergency object

#
# CiA 301 SDO
#

#
# SDO provides Object Dictionary upload/download for configuration and diagnostics.
#

#
# Most slave devices need SDO server; SDO client is for masters/gateways/tools.
#
CONFIG_PKG_CANOPENNODE_USING_SDO_SERVER=y
CONFIG_PKG_CANOPENNODE_SDO_SRV_SEGMENTED=y
# CONFIG_PKG_CANOPENNODE_SDO_SRV_BLOCK is not set
CONFIG_PKG_CANOPENNODE_SDO_SRV_BUFFER_SIZE=32
CONFIG_PKG_CANOPENNODE_USING_SDO_CLIENT=y
CONFIG_PKG_CANOPENNODE_SDO_CLI_SEGMENTED=y
# CONFIG_PKG_CANOPENNODE_SDO_CLI_BLOCK is not set
CONFIG_PKG_CANOPENNODE_SDO_CLI_LOCAL=y
CONFIG_PKG_CANOPENNODE_SDO_CLI_BUFFER_SIZE=32
# end of CiA 301 SDO

CONFIG_PKG_CANOPENNODE_USING_TIME=y
# CONFIG_PKG_CANOPENNODE_TIME_PRODUCER is not set

#
# CiA 301 SYNC and PDO
#

#
# SYNC provides a network synchronization event; PDO transfers process data.
#

#
# RPDO receives process data; TPDO transmits process data.
#
CONFIG_PKG_CANOPENNODE_USING_SYNC=y
CONFIG_PKG_CANOPENNODE_SYNC_PRODUCER=y
CONFIG_PKG_CANOPENNODE_USING_PDO=y
CONFIG_PKG_CANOPENNODE_RPDO=y
CONFIG_PKG_CANOPENNODE_TPDO=y
CONFIG_PKG_CANOPENNODE_RPDO_TIMERS=y
CONFIG_PKG_CANOPENNODE_TPDO_TIMERS=y
CONFIG_PKG_CANOPENNODE_PDO_SYNC=y
CONFIG_PKG_CANOPENNODE_PDO_OD_IO_ACCESS=y
# CONFIG_PKG_CANOPENNODE_PDO_BITWISE_MAPPING is not set
# end of CiA 301 SYNC and PDO

# CONFIG_PKG_CANOPENNODE_USING_STORAGE is not set
CONFIG_PKG_CANOPENNODE_USING_LEDS=y
# CONFIG_PKG_CANOPENNODE_LEDS_USING_RTT_PIN is not set

#
# CiA 304 safety-related objects
#
# CONFIG_PKG_CANOPENNODE_USING_GFC is not set
# CONFIG_PKG_CANOPENNODE_USING_SRDO is not set
# end of CiA 304 safety-related objects

#
# CiA 305 LSS
#

#
# LSS discovers/configures node ID and bitrate during commissioning.
#

#
# LSS slave is for configurable devices; LSS master is for tools/gateways/managers.
#
CONFIG_PKG_CANOPENNODE_USING_LSS_SLAVE=y
# CONFIG_PKG_CANOPENNODE_LSS_SLAVE_FASTSCAN_DIRECT_RESPOND is not set
# CONFIG_PKG_CANOPENNODE_USING_LSS_MASTER is not set
# end of CiA 305 LSS

CONFIG_PKG_CANOPENNODE_USING_GATEWAY_ASCII=y
# CONFIG_PKG_CANOPENNODE_GATEWAY_MULTI_NET is not set
CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_SDO=y
CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_NMT=y
# CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_LOG is not set
CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_ERROR_DESC=y
CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_PRINT_HELP=y
# CONFIG_PKG_CANOPENNODE_GATEWAY_ASCII_PRINT_LEDS is not set
CONFIG_PKG_CANOPENNODE_GTW_BLOCK_DL_LOOP=1
CONFIG_PKG_CANOPENNODE_GTWA_COMM_BUF_SIZE=200
CONFIG_PKG_CANOPENNODE_GTWA_LOG_BUF_SIZE=2000

#
# Helper and debug objects
#

#
# FIFO/CRC16 are helpers for optional modules; trace/debug are bring-up aids.
#
# CONFIG_PKG_CANOPENNODE_USING_CRC16 is not set
CONFIG_PKG_CANOPENNODE_USING_FIFO=y
# CONFIG_PKG_CANOPENNODE_FIFO_ALT_READ is not set
# CONFIG_PKG_CANOPENNODE_FIFO_CRC16_CCITT is not set
CONFIG_PKG_CANOPENNODE_FIFO_ASCII_COMMANDS=y
CONFIG_PKG_CANOPENNODE_FIFO_ASCII_DATATYPES=y
# end of Helper and debug objects
