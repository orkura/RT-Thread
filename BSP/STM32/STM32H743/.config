#
# RT-Thread runtime options
#

#
# CAN RX helper thread
#
CONFIG_PKG_CANOPENNODE_RX_THREAD_STACK_SIZE=2048
CONFIG_PKG_CANOPENNODE_RX_THREAD_PRIORITY=2
CONFIG_PKG_CANOPENNODE_RX_THREAD_TICK=10
CONFIG_PKG_CANOPENNODE_RX_BATCH_SIZE=8
# end of CAN RX helper thread

#
# CANopen mainline thread
#
CONFIG_PKG_CANOPENNODE_MAIN_THREAD_STACK_SIZE=2048
CONFIG_PKG_CANOPENNODE_MAIN_THREAD_PRIORITY=10
CONFIG_PKG_CANOPENNODE_MAIN_THREAD_TICK=10
# end of CANopen mainline thread

#
# CANopen realtime thread
#
CONFIG_PKG_CANOPENNODE_RT_THREAD_STACK_SIZE=2048
CONFIG_PKG_CANOPENNODE_RT_THREAD_PRIORITY=3
CONFIG_PKG_CANOPENNODE_RT_THREAD_TICK=10
CONFIG_PKG_CANOPENNODE_TIMER_PERIOD_US=1000
# end of CANopen realtime thread

#
# CANopen application runtime
#
CONFIG_PKG_CANOPENNODE_APP_FIRST_HB_TIME_MS=500
CONFIG_PKG_CANOPENNODE_APP_SDO_SRV_TIMEOUT_MS=1000
CONFIG_PKG_CANOPENNODE_APP_SDO_CLI_TIMEOUT_MS=500
# end of CANopen application runtime

CONFIG_PKG_CANOPENNODE_APP_AUTO_INIT=y
CONFIG_PKG_CANOPENNODE_AUTO_INIT_NODE_ID=2
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_10 is not set
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_20 is not set
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_50 is not set
