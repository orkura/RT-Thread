#
# CONFIG_PKG_CANOPENNODE_PROFILE_REGISTRY is not set
# CONFIG_PKG_CANOPENNODE_PROFILE_MASTER_RTT is not set
# CONFIG_PKG_CANOPENNODE_CIA401 is not set
# CONFIG_PKG_CANOPENNODE_CIA402 is not set
# CONFIG_PKG_CANOPENNODE_PROFILE_MIXED_RTT is not set
# end of CANopen profiles

#
# Object Dictionary
#
CONFIG_PKG_CANOPENNODE_USING_DEMO_OD=y

