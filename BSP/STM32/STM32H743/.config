CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_250=y
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_500 is not set
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_800 is not set
# CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE_1000 is not set
CONFIG_PKG_CANOPENNODE_AUTO_INIT_BITRATE=250
CONFIG_PKG_CANOPENNODE_GATEWAY_RTT_CONSOLE=y
# end of RT-Thread runtime options
# end of RT-Thread integration

