import os

from building import *

Import('BSP_ROOT')
Import('rtconfig')

cwd = GetCurrentDir()
variant_root = os.path.join(BSP_ROOT, rtconfig.BUILD_OUTPUT_DIR,
                            'project', 'components')
objs = []

# Register each BSP-specific component explicitly, for example:
# objs.extend(SConscript(os.path.join(cwd, 'MotorControl', 'SConscript'),
#                        variant_dir=os.path.join(variant_root, 'MotorControl'),
#                        duplicate=0))

# Register the CANopenNode RT-Thread component explicitly.
canopennode_script = os.path.join(cwd, 'canopennode-rtt', 'SConscript')
if not os.path.isfile(canopennode_script):
    raise FileNotFoundError(
        'Missing component SConscript: ' + canopennode_script
    )

objs.extend(
    SConscript(
        canopennode_script,
        variant_dir=os.path.join(variant_root, 'canopennode-rtt'),
        duplicate=0,
    )
)

Return('objs')
